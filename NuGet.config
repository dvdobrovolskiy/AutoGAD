<!--
  The machine-level NuGet config lists a source that doesn't exist
  ("C:\Program Files (x86)\Microsoft SDKs\NuGetPackages\"), which fails restore with NU1301.
  Clearing inherited sources and pinning nuget.org keeps the build working with any dotnet SDK.
  AutoGAD has no package dependencies - restore only needs the net8.0 targeting packs.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
